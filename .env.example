PORT=3000
NODE_ENV=development

# Base de Datos (PostgreSQL)
# Opción 1: Neon (production/staging) — usa DATABASE_URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Opción 2: PostgreSQL local (development) — usa variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=mec3d_db

# Seguridad
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32 (el servidor no arranca en producción con este valor de ejemplo)
JWT_SECRET=GENERAR_CON_openssl_rand_hex_32_jwt
JWT_EXPIRES_IN=1d
# Secreto HMAC del código de entrega (mínimo 32 caracteres, distinto de JWT_SECRET). Obligatorio en producción.
DELIVERY_CODE_SECRET=GENERAR_CON_openssl_rand_hex_32_delivery
# Swagger en producción solo si ENABLE_DOCS=true
# ENABLE_DOCS=false
# Hosts extra permitidos para archivoUrl/imagenUrl (coma). Opcional.
# ALLOWED_ASSET_HOSTS=
# Solo dev: desactivar validación del certificado TLS de la DB (prohibido en producción)
# DB_SSL_REJECT_UNAUTHORIZED=false
# Scripts destructivos (db:init / db:truncate / db:seed): --force o CONFIRM_DESTRUCTIVE=yes
# (contra una DB que no sea localhost, siempre --force explícito)
# CONFIRM_DESTRUCTIVE=yes
# db:seed exige una contraseña (mín. 8 caracteres) para los usuarios de prueba; no hay valor por defecto
# SEED_PASSWORD=
# db:bootstrap (base en cero + datos de referencia + 1 admin real): ADMIN_EMAIL y ADMIN_PASSWORD son
# obligatorias, solo por entorno (nunca por argv). La contraseña sigue la política del registro.
# Requiere además --force y --confirm-db=<nombre de la base destino>; nunca con NODE_ENV=production.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Timeouts por conexión de la DB (ms)
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000

# Subidas simultáneas en curso (429 al superarlas): por usuario (default 2) y global (default 10)
# UPLOAD_MAX_CONCURRENT_PER_USER=2
# UPLOAD_MAX_CONCURRENT_GLOBAL=10

# Políticas de pagos
# Días que el payout de una descarga queda retenido antes de poder pagarse (default 14)
# PAYOUT_HOLD_DAYS=14
# Días tras los que una orden 'confirmada' sin completar pasa a revisión admin (default 7; nunca libera fondos)
# DELIVERY_TIMEOUT_DAYS=7
# Intervalo (ms) del scheduler (reconciliación con MP, reintento de reembolsos, entregas vencidas).
# En producción corre por defecto cada 300000; fuera de producción solo si se define. 0 = desactivado.
# RECONCILIATION_INTERVAL_MS=300000

# CORS — dominio del frontend (separá múltiples con coma)
CORS_ORIGIN=http://localhost:5173

# Integraciones de Pago (Mercado Pago Checkout Pro)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxx-xxxxxxxxx-xxxxxxxxxx
# Clave secreta de Webhooks (panel de MP > Tus integraciones > Webhooks), mínimo 16 caracteres
MP_WEBHOOK_SECRET=GENERAR_CON_openssl_rand_hex_32_webhook
# URL pública (https en producción) de POST /api/v1/webhooks/mercadopago
MP_NOTIFICATION_URL=https://tu-api.example.com/api/v1/webhooks/mercadopago
# URL del frontend para los back_urls (/pago/exito, /pago/error, /pago/pendiente)
FRONTEND_URL=http://localhost:5173

# Almacenamiento en la Nube (Cloudinary)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Almacenamiento en la Nube (Cloudflare R2 - archivos de diseño 3D)
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=tu_bucket_name
R2_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://tu_dominio_publico_o_r2_dev

# AWS S3 (opcional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret
AWS_S3_BUCKET_NAME=tu_bucket_name
